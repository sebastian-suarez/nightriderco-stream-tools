    outline: none;
}

#previewZoomOutButton {
    border: none;
    border-radius: 0px;
    outline: none;
}

#previewZoomInButton:!hover,
#previewZoomOutButton:!hover {
    background-color: transparent;
}

#previewZoomInButton:pressed,
#previewZoomOutButton:pressed {
    background-color: #1b2b39;
}

#previewZoomInButton:focus,
#previewZoomOutButton:focus {
    border: 1px solid #597384;
}


.btn-create-new {
    background: transparent;
    padding: 16px 4px;
    border-radius: 5px;
    border: 2px dashed #3c5262;
    outline: none;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/plus.svg);
    margin-bottom: 4px;
}

SourceSelectButton {
    background: #1b2b39;
    padding: 2px 4px;
    margin: 1.6px;
    border-radius: 5px;
    border: 1px solid #3c5262;
    outline: none;
}

SourceSelectButton QLabel {
    padding: 4px 0;
    text-align: center;
}

SourceSelectButton #thumbnail {
    background: #141e29;
    border-radius: 5px;
    padding: 0;
    margin-top: 1.6px;
}

SourceSelectButton:hover {
    background-color: #1b2a36;
}

SourceSelectButton:checked {
    background-color: #162c38;
    border-color: #1b2a36;
}

SourceSelectButton:focus,
SourceSelectButton:checked:focus {
    border-color: #b9cbd9;
}

SourceSelectButton:pressed,
SourceSelectButton:pressed:hover {
    background-color: #101923;
    border-color: #2b3948;
}


idian--Group {
    border-radius: 5px;
    font-weight: bold;
    margin: 0 0 1.6px;
    min-width: 300px;
    max-width: 600px;
}

idian--Group .header .title {
    font-weight: bold;
    padding: 4px 0;
}

idian--Group .header .description {
    color: #94a8ba;
    padding: 1px 0;
}

idian--PropertiesList {
    border-width: 0;
    padding: 0;
    margin: 1.6px 0;
}

idian--Row {
    background: #1b2b39;
    margin: 0;
    padding: 6px 12px;
}

idian--Row.keyFocus {
    background: #2b3948;
    border: 1px solid #2b3948;
}

idian--Row.cursor-pointer.hover {
    background: #2b3948;
    border: 1px solid #94a8ba;
}

idian--Row.first {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

idian--Row.last {
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

idian--Row > QLabel.description {
    font-size: 9.6pt;
    color: #94a8ba;
}

idian--ToggleSwitch {
    qproperty-background: #141e29;
    qproperty-background_hover: #0b1118;
    qproperty-background_checked: #162c38;
    qproperty-background_checked_hover: #1b2a36;

    min-width: 46.44;
    min-height: 23.22;

    border-radius: 11.61;

    qproperty-handleColor: #f2f6fa;
    qproperty-handleSize: 15.898;

    border: 1px solid transparent;
}

idian--ToggleSwitch.hover {
    border-color: #2b3948;
}

idian--ToggleSwitch.checked.hover {
    border-color: #f2f6fa;
}

idian--ToggleSwitch.keyFocus {
    border-color: #89d8ee;
}

idian--Row idian--ToggleSwitch.hover,
idian--Row.hover > idian--ToggleSwitch.row-buddy {
    border-color: #94a8ba;
}

idian--Row idian--ToggleSwitch.hover.checked,
idian--Row.hover > idian--ToggleSwitch.checked.row-buddy {
    border-color: #f2f6fa;
}

idian--Row QComboBox {
    background-color: transparent;
    min-height: 25.8;
    max-height: 25.8;
    min-width: 103.2;
    border: 1px solid transparent;
    padding: 0;
    padding-left: 7px;
    margin: 0;
}

idian--Row QComboBox:focus {
    border-color: transparent;
}

idian--Row QComboBox.hover {
    border-color: #94a8ba;
}

idian--Row QComboBox.keyFocus {
    border-color: #89d8ee;
}

idian--Row QComboBox::drop-down {
    border: none;
}

idian--Row QComboBox::down-arrow {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/collapse.svg);
}

idian--Row QComboBox QAbstractItemView {
    outline: none;
}

idian--Row QComboBox QAbstractItemView::item {
    background-color: #0b1118;
    padding: 2px 4px;
}

idian--Row QComboBox QAbstractItemView.hover::item,
idian--Row QComboBox QAbstractItemView::item:selected {
    background-color: #162c38;
    padding: 2px 4px;
}

idian--Row QPushButton,
idian--Row QSpinBox,
idian--Row QDoubleSpinBox {
    margin: 0;
    padding: 2px 12px;
}

idian--PropertiesListSpacer {
    max-height: 1px;
    min-height: 1px;
    background-color: #0b1118;
}

idian--Row idian--CheckBox {
    outline: none;
}

idian--CheckBox::indicator {
    border: 1px solid transparent;
    border-radius: 5px;
}

idian--CheckBox.keyFocus::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Yami/checkbox_unchecked_focus.svg);
}

idian--CheckBox.keyFocus.checked::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Yami/checkbox_checked_focus.svg);
}

idian--CheckBox.hover::indicator,
idian--CheckBox.checked.hover::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    border-color: #94a8ba;
}

idian--CheckBox.keyFocus::indicator,
idian--CheckBox.keyFocus.checked::indicator {
    border-color: #89d8ee;
}

idian--CollapsibleRow {
    margin: 0;
    padding: 0;
    border: none;
}

idian--CollapsibleRow.keyFocus {
    border: 1px solid #89d8ee;
}

idian--CollapsibleRow idian--PropertiesList {
    border-radius: 0;
    border-left: 1px solid #1b2b39;
    border-right: 1px solid #1b2b39;
    border-bottom: 1px solid #1b2b39;
    margin: 1px 0px 0px;
}

idian--CollapsibleRow idian--PropertiesList idian--Row {
    background-color: #141e29;
    padding-left: 18px;
}

idian--CollapsibleRow idian--Row.first,
idian--CollapsibleRow idian--Row.last {
    border-radius: 0;
}

idian--CollapsibleRow idian--PropertiesList idian--ToggleSwitch {
    qproperty-background: #0b1118;
    qproperty-background_hover: #141e29;
}

idian--ExpandButton {
    background: transparent;
    min-width: 29.8px;
    max-width: 29.8px;
    min-height: 29.8px;
    max-height: 29.8px;
    border: none;
}

idian--ExpandButton::indicator {
    background: #1b2b39;
    border-radius: 14.9px;
    padding: 4px;
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/down.svg);
    border: 1px solid #1b2b39;
}

idian--ExpandButton::indicator:checked {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/up.svg);
}

idian--ExpandButton.keyFocus,
idian--ExpandButton.keyFocus::indicator {
    border-color: #89d8ee;
}

idian--RowFrame .btn-frame {
    background: #1b2b39;
    padding: 6px 12px;
}

idian--RowFrame.hover .btn-frame {
    background: #2b3948;
}

idian--RowFrame.hover idian--Row {
    background: #2b3948;
    border: 1px solid #94a8ba;
    border-right: none;
}

idian--RowFrame.hover .row-buddy {
    background: #2b3948;
    border: 1px solid #94a8ba;
    border-left: none;
}

idian--RowFrame.hover idian--ExpandButton::indicator {
    border-color: #94a8ba;
}

AlignmentSelector {
    border: 1px solid #2b3948;
    margin: 0px;
    border-radius: 2px;
}

AlignmentSelector:focus,
AlignmentSelector:hover {
    border: 1px solid #b9cbd9;
}

AlignmentSelector:checked:hover {
    border: 1px solid #89d8ee;
}

AlignmentSelector::indicator {
    margin: 0px;
    background: transparent;    
}

AlignmentSelector::indicator:checked {
    background: #162c38;
}

AlignmentSelector::indicator:checked:focus {
    background: #1b2a36;
}

AlignmentSelector:disabled {
    border: 1px solid #3c5262;
}

AlignmentSelector::indicator:disabled {
    background: #1b2b39;
}

AlignmentSelector::indicator:checked:disabled {
    background: #3c5262;
}






QWidget {
    font-family: '.AppleSystemUIFont', Helvetica, Arial;
}


QDockWidget::title {
    background-color: #0b1118;
    border: none;
    color: #f2f6fa;
    padding: 6px 16px 6px 36px;
    text-align: left center;
}

QDockWidget::title:!closable {
    padding-left: 20px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    subcontrol-origin: margin;
    subcontrol-position: center left;
    position: absolute;
    top: 0px;
    width: 20px;
    height: 20px;
    margin: 0px;
    padding: 2px;
}

QDockWidget::close-button {
    left: 8px;
}

QDockWidget::float-button {
    left: 40px;
}

QDockWidget::float-button:!closable {
    left: 8px;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    padding: 2px;
}


.text-bright {
    color: #89d8ee;
}

QListView::item:hover:!selected:enabled,
QListWidget::item:hover:!selected:enabled {
    background-color: #1b2a36;
}

QTabBar::tab:selected:enabled {
    color: #89d8ee;
    border-color: #89d8ee;
}


QGroupBox {
    background-color: #141e29;
    border-radius: 10px;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
}

QPushButton:checked:enabled {
    border-color: #89d8ee;
}

#controlsFrame QPushButton {
    margin: 4px 0px;
}


QComboBox,
QSpinBox,
QDoubleSpinBox,
QLineEdit,
QTextEdit,
QPlainTextEdit {
    border-color: #2b3948;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
    placeholder-text-color: #94a8ba;
}


QPushButton:focus:enabled,
QToolButton:focus:enabled,
QComboBox:focus:enabled,
QLineEdit:focus:enabled,
QTextEdit:focus:enabled,
QPlainTextEdit:focus:enabled,
QSpinBox:focus:enabled,
QDoubleSpinBox:focus:enabled,
QListView::item:focus,
QListWidget::item:focus {
    border-color: #89d8ee;
}

QSlider::handle:focus:enabled {
    background-color: #89d8ee;
}

QCheckBox:focus:enabled,
QRadioButton:focus:enabled {
    outline: 1px solid #89d8ee;
    outline-offset: 1px;
}

QToolTip {
    background-color: #1b2b39;
    color: #f2f6fa;
    border: 1px solid #2b3948;
}


VolumeMeter {
    color: #94a8ba;
    qproperty-minorTickColor: #94a8ba;
}


QMainWindow > QTabBar {
    qproperty-drawBase: false;
    background-color: #0b1118;
    border: none;
}

QMainWindow > QTabBar::tab,
QMainWindow > QTabBar::tab:top,
QMainWindow > QTabBar::tab:bottom {
    background-color: #1b2b39;
    color: #94a8ba;
    border: 1px solid #2b3948;
    border-radius: 5px;
    padding: 5px 9px;
    margin: 4px 2px;
}

QMainWindow > QTabBar::tab:hover:!selected {
    background-color: #1b2a36;
    border-color: #597384;
    color: #f2f6fa;
}

QMainWindow > QTabBar::tab:selected {
    background-color: #162c38;
    border-color: #89d8ee;
    color: #89d8ee;
}

QMainWindow > QTabBar::tab:focus {
    border-color: #89d8ee;
}


OBSDock > QWidget {
    margin-top: 8px;
    border: 1px solid #2b3948;
    border-radius: 10px;
    padding: 4px;
}


#canvasEditor OBSQTDisplay,
#preview {
    qproperty-displayBackgroundColor: #0b1118;
}

.label-preview-title {
    qproperty-alignment: AlignCenter;
    margin-top: 14px;
    margin-bottom: 14px;
}


.label-preview-title[nrcMainWindowInset="true"] {
    margin-top: 6px;
}

#contextContainer {
    background-color: #141e29;
    border: 1px solid #2b3948;
    border-radius: 10px;
    margin-top: 8px;
    padding: 6px;
}


#streamButton.state-active:enabled:!hover:!pressed,
#streamButton.state-active:enabled:hover:!pressed,
#streamButton.state-active:enabled:pressed {
    color: #ffffff;
    border: 2px solid #f07986;
    font-weight: bold;
}

#streamButton.state-active:enabled:!hover:!pressed {
    background-color: #b82e3f;
}

#streamButton.state-active:enabled:hover:!pressed {
    background-color: #c63849;
}

#streamButton.state-active:enabled:pressed {
    background-color: #922233;
}

#streamButton.state-active:enabled:focus:!hover:!pressed,
#streamButton.state-active:enabled:focus:hover:!pressed,
#streamButton.state-active:enabled:focus:pressed {
    border-color: #ffffff;
}

#streamButton.state-active:disabled:!hover:!pressed,
#streamButton.state-active:disabled:hover:!pressed,
#streamButton.state-active:disabled:pressed {
    background-color: #54242f;
    color: #dce7ef;
    border: 2px solid #a55d68;
}


BrowserDock > QWidget {
    margin: 0px;
    padding: 0px;
    border: none;
    border-radius: 0px;
}


#dockWidgetContents_2,
#dockWidgetContents_6 {
    margin: 0px;
    padding: 0px;
    border: none;
}
#scenesFrame,
#sourcesFrame {
    margin-top: 8px;
    padding: 4px;
    border: 1px solid #2b3948;
    border-radius: 10px;
    background-color: #0b1118;
}


QFrame#nrcPreviewFrame,
QFrame#nrcProgramFrame {
    background-color: #0b1118;
    border: 1px solid #2b3948;
    border-radius: 10px;
    margin: 0px;
    padding: 0px;
}
