








.bg_window {
    background-color: #0b1118;
}

.bg-base {
    background-color: #0b1118;
}

.text-title {
    font-size: 13.2pt;
    font-weight: bold;
}

.text-small {
    font-size: 9.6pt;
}

.text-tiny {
    font-size: 7.8pt;
}

.text-heading {
    font-size: 30pt;
    font-weight: bold;
}

.text-large {
    font-size: 13.2pt;
}

.text-bold {
    font-weight: bold;
}

.text-italic {
    font-style: italic;
}

.text-bright {
    color: #1b2a36;
}

.text-muted {
    color: #94a8ba;
}

.text-warning {
    color: #B88A16;
}

.text-danger {
    color: #C01C37;
}

.text-success {
    color: #25A231;
}

.frame-notice {
    background: #0b1118;
    border: 1px solid #141e29;
    border-radius: 5px;
    padding: 7px 4px;
}

.frame-notice QLabel {
    padding: 4px 0px;
}

.dialog-container {
    padding: 4px 7px;
}

.dialog-frame {
    background-color: #141e29;
    border-radius: 5px;
    border: 1px solid #2b3948;
    margin: 1.6px;
}

.dialog-frame > QWidget {
    margin: 1.6px 0;
}

.subtitle {
    font-size: 9.6pt;
    font-weight: bold;
    color: #94a8ba;
}

.button-primary {
    background-color: #132633;
    border-color: #162c38;
    outline: none;
}

.button-primary:hover,
.button-primary:focus {
    background-color: #162c38;
    border-color: #b9cbd9;
}

.button-primary:hover {
    border-color: #1b2a36;
}

.toolbar-button {
    background: transparent;
    font-weight: bold;
    padding: 0 7px;
    margin: 1px 1px 0px;
    border: 1px solid transparent;
    border-radius: 5px;
}

.margin {
    margin: 1.6px;
}

.margin-x {
    margin-left: 1.6px;
    margin-right: 1.6px;
}

.margin-left {
    margin-left: 1.6px;
}

.margin-right {
    margin-right: 1.6px;
}

.margin-y {
    margin-top: 1.6px;
    margin-bottom: 1.6px;
}

.margin-top {
    margin-top: 1.6px;
}

.margin-bottom {
    margin-bottom: 1.6px;
}



.icon-plus {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/plus.svg);
}

.icon-minus {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/minus.svg);
}

.icon-trash {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/trash.svg);
}

.icon-clear {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/entry-clear.svg);
}

.icon-gear {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/settings/general.svg);
}

.icon-dots-vert {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/dots-vert.svg);
}

.icon-refresh {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/refresh.svg);
}

.icon-cogs {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/cogs.svg);
}

.icon-touch {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/interact.svg);
}

.icon-up {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/up.svg);
}

.icon-down {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/down.svg);
}

.icon-pause {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media-pause.svg);
}

.icon-filter {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/filter.svg);
}

.icon-revert {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/revert.svg);
}

.icon-save {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/save.svg);
}

.icon-close {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/close.svg);
}

.icon-pin {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/pin.svg);
}

.icon-layout-vertical {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/layout-vertical.svg);
}

.icon-layout-horizontal {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/layout-horizontal.svg);
}



.icon-media-play {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_play.svg);
}

.icon-media-pause {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_pause.svg);
}

.icon-media-restart {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_restart.svg);
}

.icon-media-stop {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_stop.svg);
}

.icon-media-next {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_next.svg);
}

.icon-media-prev {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/media/media_previous.svg);
}



QWidget {
    alternate-background-color: #0b1118;
    color: #f2f6fa;
    selection-background-color: #162c38;
    selection-color: #f2f6fa;
    font-size: 12pt;
    font-family: 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

QWidget:disabled {
    color: #7b91a2;
}



QDialog,
QMainWindow,
QStatusBar,
QMenuBar,
QMenu {
    background-color: #0b1118;
}



QMainWindow::separator {
    background: transparent;
    width: 4px;
    height: 4px;
    margin: 0px;
}

QMainWindow::separator:hover {
    border: 1px solid #89d8ee;
    margin: 1px;
}



QLabel,
QGroupBox,
QCheckBox {
    background: transparent;
}

QComboBox,
QCheckBox,
QPushButton,
QSpinBox,
QDoubleSpinBox {
    margin-top: 2px;
    margin-bottom: 2px;
}

QListView QWidget,
QListWidget QWidget {
    margin-top: 0;
    margin-bottom: 0;
}

* [frameShape="1"],
* [frameShape="2"],
* [frameShape="3"],
* [frameShape="4"],
* [frameShape="5"],
* [frameShape="6"] {
    border: 1px solid #0b1118;
}

QCheckBox,
QGroupBox,
QMenuBar,
QRadioButton {
    spacing: 1px;
}



QAbstractItemView {
    background-color: #0b1118;
}

QToolTip {
    background-color: #0b1118;
    color: #f2f6fa;
    border: none;
}

QProgressBar {
    text-align: center;
    border-radius: 4px;
    border-top: 2px solid transparent;
}

QProgressBar::chunk {
    background: #162c38;
    border-top: 1px solid #89d8ee;
    border-bottom: 2px solid #132633;
    border-radius: 3px;
}



QMenu::indicator {
    left: 4px;
}

QMenu::icon {
    left: 7px;
}

QMenu::separator {
    background: #2b3948;
    height: 1px;
    margin: 1.6px 4px;
}

QMenu::item:disabled {
    color: #7b91a2;
    background: transparent;
}

QMenu::right-arrow {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/expand.svg);
}


QMenuBar::item {
    background-color: transparent;
    padding: 4px 7px;
}

QMenuBar::item:selected {
    background: #162c38;
}



QToolBar::separator {
    background: #2b3948;
    width: 1px;
    margin: 0px 1.6px 0px;
}



QListWidget {
    border-radius: 5px;
}

QListWidget::item {
    color: #f2f6fa;
}

QListView,
QListWidget,
QMenu {
    padding: 1.6px;
    outline: none;
}

QListWidget::item,
SourceTreeItem {
    padding: 4px 4px;
}

QMenu::item,
QMenu > QWidget {
    padding: 4px 12px;
    padding-right: 20px;
}

QMenu > QWidget {
    outline: none;
}

QMenu::item,
QMenu > QWidget,
QListView::item,
QListWidget::item {
    border-radius: 5px;
    color: #f2f6fa;
    border: 1px solid transparent;
}

SourceTreeItem {
    border-radius: 5px;
    color: #f2f6fa;
}

QMenu,
QMenu > QMenu {
    border: 1px solid #2b3948;
    padding: 1.6px;
}


QListView::item,
QListWidget::item,
SourceTreeItem {
    min-height: 12px;
}

SourceTreeItem .checkbox-icon {
    margin-right: 0;
    margin-left: 4px;
}

SourceTree .indicator-expand {
    margin-right: 4px;
    margin-left: 0;
}

QMenu::item:selected,
QMenu > QWidget:selected,
QListView::item:selected,
QListWidget::item:selected {
    background-color: #162c38;
    border-color: #1b2a36;
}

QMenu::item:hover,
QListView::item:hover,
QListWidget::item:hover {
    background: #2b3948;
    border: 1px solid #3c5262;
}

QMenu::item:focus,
QListView::item:focus,
QListWidget::item:focus,
QMenu::item:selected:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid #b9cbd9;
}

QMenu::item:selected:hover,
QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background: #1b2a36;
    border: 1px solid #89d8ee;
    color: #f2f6fa;
}

QListView::item:disabled,
QListView::item:disabled:hover,
QListWidget::item:disabled,
QListWidget::item:disabled:hover {
    background: transparent;
    color: #7b91a2;
}

QListView QLineEdit,
QListWidget QLineEdit {
    padding: 0;
    padding-bottom: 1px;
    margin: 0;
    border: 1px solid #f2f6fa;
    border-radius: 5px;
}

QListView QLineEdit:focus,
QListWidget QLineEdit:focus {
    border: 1px solid #94a8ba;
}



OBSBasicSettings QScrollBar:vertical {
    width: 21px;
    margin-left: 9px;
}

OBSBasicSettings QScrollBar:horizontal {
    height: 21px;
}


OBSBasicSettings #PropertiesContainer {
    background-color: #0b1118;
}

OBSPropertiesView IconLabel {
    margin-left: 4px;
}


OBSDock > QWidget {
    background: #0b1118;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border: 1px solid #2b3948;
    border-top: none;
}

OBSDock QToolBar {
    padding: 1px;
    margin: 0px;
    height: 32px;
    max-height: 32px;
    border-top: 1px solid #2b3948;
    spacing: 0;
}

OBSDock QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    margin: 1px;
    margin-top: 2px;
    padding: 4px;
    max-width: 16px;
    max-height: 16px;
}

OBSDock QToolBar QToolButton:hover {
    border-color: #94a8ba;
}

OBSDock QToolBar QToolButton:disabled {
    background: #0b1118;
}

#transitionsFrame {
    padding: 14px;
}

OBSDock QLabel {
    background: transparent;
}

QDockWidget {
    font-size: 12pt;
    font-weight: bold;

    titlebar-close-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/close.svg);
    titlebar-normal-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/popout.svg);
}

QDockWidget::title {
    text-align: left;
    background-color: #1b2b39;
    padding: 4px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    border: none;
    border-radius: 5px;
    background: transparent;
    margin-right: 1px;
    min-width: 16px;
    min-height: 16px;
    icon-size: 16px;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: #1b2a36;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background: #101923;
    padding: 1px -1px -1px 1px;
}

QAbstractScrollArea {
    border-radius: 5px;
}


QScrollArea > QWidget > QWidget {
    background: transparent;
}


OBSBasicStatusBar {
    margin-top: 4px;
    border-top: 1px solid #2b3948;
    background: #0b1118;
}

StatusBarWidget > QFrame {
    border: 0px solid #2b3948;
    border-left-width: 1px;
    padding: 0px 7px 1px;
}



QGroupBox {
    background: #0b1118;
    border-radius: 5px;
    padding-top: 34.4;
    padding-bottom: 4px;
    font-weight: bold;
    margin-bottom: 4px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 4px;
    top: 4px;
}




QScrollBar {
    background-color: #0b1118;
    margin: 0px;
    border-radius: 5px;
    border: 1px solid #141e29;
}

::corner {
    background-color: #0b1118;
    border: none;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    border: none;
    background: none;
    color: none;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: none;
    color: none;
}

QScrollBar::handle {
    background-color: #597384;
    margin: 2px;
    border-radius: 3px;
    border: 1px solid #597384;
}

QScrollBar::handle:hover {
    background-color: #94a8ba;
    border-color: #2b3948;
}

QScrollBar::handle:pressed {
    background-color: #94a8ba;
    border-color: #94a8ba;
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::handle:disabled {
    background: transparent;
    border-color: transparent;
}

OBSDock QScrollBar {
    border-radius: 0;
}

OBSDock QListWidget::corner {
    background: transparent;
    border-top: 1px solid #2b3948;
    border-left: 1px solid #2b3948;
}

OBSDock QScrollBar:horizontal {
    border-top: 1px solid #2b3948;
}

OBSDock QScrollBar:vertical {
    border-left: 1px solid #2b3948;
}



#contextContainer {
    background-color: #0b1118;
    margin-top: 4px;
    border-radius: 5px;
}

#contextContainer QPushButton {
    padding-left: 12px;
    padding-right: 12px;
}

QPushButton#sourcePropertiesButton {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/settings/general.svg);
    icon-size: 16px;
}

QPushButton#sourceFiltersButton {
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/filter.svg);
    icon-size: 16px;
}



QToolBar {
    background-color: transparent;
    border: none;
    margin: 1.6px 0px;
    spacing: 1.6px;
}

QToolBarExtension {
    background: #1b2b39;
    min-width: 12px;
    max-width: 12px;
    padding: 4px 0px;
    margin-left: 0px;

    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/dots-vert.svg);
}





QTabWidget::pane {
    border-top: 4px solid #141e29;
}

QTabBar {
    outline: none;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar QToolButton {
    background: #1b2b39;
    border: none;
}

QTabBar::tab:top {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:bottom {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTabBar::tab {
    background: #141e29;
    color: #f2f6fa;
    border: none;
    padding: 7px 11px;
    min-width: 50px;
    margin: 1px 0px;
    margin-right: 2px;
    border: 1px solid #2b3948;
}

QTabBar::tab:pressed {
    background: #162c38;
}

QTabBar::tab:hover {
    background: #1b2a36;
    border-color: #597384;
    color: #f2f6fa;
}

QTabBar::tab:focus {
    border-color: #89d8ee;
}

QTabBar::tab:selected {
    background: #162c38;
    color: #f2f6fa;
}

QTabBar::tab:top {
    border-bottom: 0px solid transparent;
    margin-bottom: 0px;
}

QTabBar::tab:bottom {
    border-top: 0px solid transparent;
    margin-top: 0px;
}

QTabBar QToolButton {
    background: #1b2b39;
    min-width: 16px;
    padding: 0px;
}



QComboBox,
QDateTimeEdit {
    background-color: #101923;
    border: 1px solid #101923;
    border-radius: 5px;
    padding: 5px 9px;
    height: 24.4px;
}

QComboBox QAbstractItemView {
    padding: 1.6px 4px;
    border: 1px solid #2b3948;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 7px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #162c38;
}

QComboBox:hover,
QComboBox:focus,
QDateTimeEdit:hover,
QDateTimeEdit:selected {
    border-color: #597384;
}

QComboBox:on {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    border-left: 1px solid #141e29;
    width: 24.4px;
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow {
    qproperty-alignment: AlignTop;
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/collapse.svg);
    width: 100%;
}

QComboBox:editable:hover {
    background-color: #101923;
    border-color: #597384;
}

QComboBox:on,
QDateTimeEdit:on,
QComboBox:editable:focus {
    background-color: #101923;
    border-color: #89d8ee;
}

QComboBox::drop-down:editable,
QDateTimeEdit::drop-down:editable {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow:editable,
QDateTimeEdit::down-arrow:editable {
    qproperty-alignment: AlignTop;
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/collapse.svg);
    width: 100%;
}



QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #101923;
    border: none;
    border-radius: 5px;
    padding: 5px 9px;
    border: 1px solid #101923;
    height: 24.4px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #101923;
    border-color: #597384;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    background-color: #101923;
    border-color: #89d8ee;
}

QLineEdit:read-only,
QLineEdit:read-only:hover,
QLineEdit:read-only:focus {
    background-color: transparent;
    border-color: #101923;
}

QTextEdit:!editable,
QTextEdit:!editable:hover,
QTextEdit:!editable:focus {
    background-color: #101923;
}



QSpinBox,
QDoubleSpinBox {
    background-color: #101923;
    border: 1px solid #101923;
    border-radius: 5px;
    padding: 5px 9px;
    height: 24.4px;
    min-width: 44.4px;
    max-height: 24.4px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: #101923;
    border-color: #597384;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: #101923;
    border-color: #89d8ee;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    
    subcontrol-position: top right;

    width: 24.4px;
    height: 16.2px;
    border-left: 1px solid #141e29;
    border-bottom: 1px solid transparent;
    border-radius: 0px;
    border-top-right-radius: 3px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    
    subcontrol-position: bottom right;

    width: 24.4px;
    height: 16.2px;
    border-left: 1px solid #141e29;
    border-top: 1px solid #141e29;
    border-radius: 0px;
    border-bottom-right-radius: 3px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1b2a36;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #101923;
}

QSpinBox::up-button:disabled,
QSpinBox::up-button:off,
QSpinBox::down-button:disabled,
QSpinBox::down-button:off {
    background-color: #141e29;
}

QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:off,
QDoubleSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:off {
    background-color: #141e29;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/up.svg);
    width: 100%;
    margin: 2px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/down.svg);
    width: 100%;
    padding: 2px;
}


#controlsFrame {
    padding: 14px;
}

#controlsFrame QPushButton {
    margin: 1.6px 1px;
}

#streamButton,
#recordButton,
#replayBufferButton,
#broadcastButton {
    padding: 4px;
}

#pauseRecordButton,
#saveReplayButton,
#virtualCamConfigButton {
    padding: 4px 4px;
    width: 24.4px;
    max-width: 24.4px;
}


#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: #162c38;
}


#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:!pressed.state-active,
#virtualCamButton:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: #1b2a36;
    color: #f2f6fa;
}




QPushButton {
    background-color: #1b2b39;
    color: #f2f6fa;
    border: 1px solid #2b3948;
    border-radius: 5px;
    height: 24.4px;
    max-height: 24.4px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding: 5px 16px;
    icon-size: 16px;
    outline: none;
}

QPushButton:hover {
    background-color: #1b2a36;
}

QPushButton:hover,
QPushButton:focus {
    border-color: #597384;
}

QPushButton::flat {
    background-color: #1b2b39;
}

QPushButton:checked {
    background-color: #162c38;
    border-color: #1b2a36;
}

QPushButton:checked:hover,
QPushButton:checked:focus {
    border-color: #89d8ee;
}

QPushButton:pressed,
QPushButton:pressed:hover {
    background-color: #101923;
    border-color: #2b3948;
}

QPushButton:disabled {
    background-color: #141e29;
    border-color: #2b3948;
}

QPushButton::menu-indicator {
    image: url(/Applications/OBS.app/Contents/Resources/themes/Dark/collapse.svg);
    subcontrol-position: right;
    subcontrol-origin: content;
    margin-left: 4px;
    right: -2px;
}

QToolButton {
    border: 1px solid #2b3948;
}

QToolButton,
.btn-tool {
    background-color: #1b2b39;
    padding: 2px 2px;
    margin: 0px 0px;
    border: 1px solid #2b3948;
    border-radius: 5px;
    icon-size: 16px;
}

QToolButton:last-child,
.btn-tool:last-child {
    margin-right: 0px;
}

QToolButton:hover,
QToolButton:focus,
.btn-tool:hover,
.btn-tool:focus {
    border-color: #2b3948;
    background-color: #1b2a36;
}

QToolButton:checked,
.btn-tool:checked {
    background-color: #162c38;
    border-color: #1b2a36;
}

QToolButton:checked:hover,
QToolButton:checked:focus,
.btn-tool:checked:hover,
.btn-tool:checked:focus {
    border-color: #89d8ee;
}

QToolButton:pressed,
QToolButton:pressed:hover,
.btn-tool:pressed,
.btn-tool:pressed:hover {
    background-color: #101923;
    border-color: #2b3948;
}

QToolButton:disabled,
.btn-tool:disabled {
    background-color: #141e29;
    border-color: transparent;
}



QSlider::groove {
    background-color: #2b3948;
    border: none;
    border-radius: 2px;
}

QSlider::groove:horizontal {
    height: 4px;
}

QSlider::groove:vertical {
    width: 4px;
}

QSlider::sub-page:horizontal {
    background-color: #89d8ee;
    border-radius: 2px;
}

QSlider::sub-page:horizontal:disabled {
    background-color: #2b3948;
    border-radius: 2px;
}

QSlider::add-page:horizontal:disabled {
    background-color: #0b1118;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background-color: #89d8ee;
    border-radius: 2px;
}

QSlider::add-page:vertical:disabled {
    background-color: #2b3948;
    border-radius: 2px;
}

QSlider::sub-page:vertical:disabled {
    background-color: #0b1118;
    border-radius: 2px;
}

QSlider::handle {
    background-color: #f2f6fa;
    border-radius: 5px;
}

QSlider::handle:horizontal {
    height: 10px;
    width: 20px;
    
    margin: -3px 0;
}

QSlider::handle:vertical {
    width: 10px;
    height: 20px;
    
    margin: 0 -3px;
}

QSlider::handle:hover {
    background-color: #94a8ba;
}

QSlider::handle:pressed {
    background-color: #b9cbd9;
}

QSlider::handle:disabled {
    background-color: #94a8ba;
}

#stackedMixerArea {
    border: none;
    padding: 0px;
}

.mixer-category {
    color: #94a8ba;
    margin: 0;
    padding: 0;
    text-align: center;
}



.btn-mute,
.btn-monitor {
    width: 16px;
    height: 16px;
    background-color: transparent;
    padding: 3px 3px;
    margin: 0px 1px;
    border: 1px solid transparent;
    border-radius: 5px;
    icon-size: 16px;
}

.btn-mute:checked,
.btn-monitor:checked {
    background-color: transparent;
    border-color: transparent;
}

.btn-mute:hover,
.btn-monitor:hover {
    background-color: #1b2a36;
    border-color: transparent;
}

.btn-mute:pressed,
.btn-monitor:pressed {
    background-color: #101923;
}



.btn-mute {
    color: #f2f6fa;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/settings/audio.svg);
}

.btn-mute.checked {
    color: #C01C37;
    background: transparent;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/mute.svg);
}

.btn-mute.checked.hover {
    color: #E33B57;
    background: #0b1118;
    border-color: #E85E75;
}

.btn-mute.checked:focus {
    border-color: #E85E75;
}

.btn-mute.mute-warning {
    color: #EABC48;
    background: #493709;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/unassigned.svg);
}

.btn-mute.mute-warning.hover,
.btn-mute.mute-warning:focus {
    border-color: #EABC48;
}



.btn-monitor {
    background: transparent;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/headphones-off.svg);
}

.btn-monitor:focus {
    border-color: #E85E75;
}

.btn-monitor.checked {
    background: #1E8528;
    color: #f2f6fa;
    qproperty-icon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/headphones.svg);
}

.btn-monitor.checked:focus,
.btn-monitor:checked:focus {
    color: #f2f6fa;
    border-color: #59D966;
}

.btn-monitor.checked:hover {
    background: #25A231;
    border-color: #59D966;
    color: #f2f6fa;
}



.toggle-hidden:checked {
    background: #3D2380;
    border-color: #5B34BF;
}

.toggle-hidden:disabled {
    background: transparent;
    border-color: transparent;
}

VolumeControl,
VolumeMeter {
    background: #0b1118;
}

VolumeMeter {
    color: #3c5262;
    font-size: 6pt;
    font-weight: bold;
    
    qproperty-backgroundNominalColor: #17641E;
    qproperty-backgroundWarningColor: #6E520D;
    qproperty-backgroundErrorColor: #7D1224;
    qproperty-foregroundNominalColor: #37D247;
    qproperty-foregroundWarningColor: #E5AF24;
    qproperty-foregroundErrorColor: #E33B57;
    qproperty-magnitudeColor: rgb(0, 0, 0);
    qproperty-majorTickColor: #94a8ba;
    qproperty-minorTickColor: #94a8ba;

    qproperty-backgroundNominalColorDisabled: #646464;
    qproperty-backgroundWarningColorDisabled: #828282;
    qproperty-backgroundErrorColorDisabled: #414141;
    qproperty-foregroundNominalColorDisabled: #b9cbd9;
    qproperty-foregroundWarningColorDisabled: #b9cbd9;
    qproperty-foregroundErrorColorDisabled: #94a8ba;
}

VolumeName {
    background: transparent;
    padding: 2px 0;
    border: 1px solid transparent;
}

VolumeName QLabel {
    font-size: 9.6pt;
}

VolumeName:focus {
    border: 1px solid #597384;
}

VolumeName:hover {
    background: #1b2a36;
    border: 1px solid #597384;
}

VolumeControl #volLabel {
    min-width: 48px;
    padding: 2px 0px 2px;
    text-align: center;
    font-size: 9.6pt;
    color: #94a8ba;
}


#hVolumeWidgets VolumeControl {
    padding: 0px 0px;
    border-bottom: 1px solid #2b3948;
    margin-bottom: 0px;
}

#hVolumeWidgets .mixer-category {
    margin: 1.6px;
    padding: 0px 7px;
    border-radius: 5px;
}

#hVolumeWidgets VolumeName {
    padding-right: 4px;
}

#hVolumeWidgets VolumeName QLabel {
    margin: 0 4px;
}

#hVolumeWidgets #volLabel {
    margin: 0 1.6px;
    border-radius: 5px;
}

#hVolumeWidgets #volMeterFrame {
    margin-bottom: 4px;
}

#hVolumeWidgets VolumeControl QSlider {
    margin: 4px 0px 4px;
}

#hVolumeWidgets VolumeControl QSlider::groove:horizontal {
    background: #0b1118;
    height: 4px;
}

#hVolumeWidgets VolumeControl QPushButton {
    margin-left: 4px;
}

#hVolumeWidgets VolumeControl #volMeterFrame {
    padding: 0 7px;
}


#vVolumeWidgets VolumeControl {
    padding: 0px 0px 14px;
    border-right: 1px solid #2b3948;
}

#vVolumeWidgets .mixer-category {
    border-bottom: 1px solid #2b3948;
}

#vMixerScrollArea VolumeControl QSlider {
    width: 16px;
    margin: 0px 7px;
}

#vVolumeWidgets VolumeControl #volLabel {
    padding: 2px 0px 2px;
    min-width: 32px;
    margin-left: 7px;
    text-align: center;
}

#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    background: #0b1118;
    width: 4px;
}

#vVolumeWidgets VolumeControl #volMeterFrame {
    padding: 4px 7px 4px 0px;
}

#vVolumeWidgets VolumeControl QLabel {
    padding: 0px 4px;
}

VolumeControl.volume-inactive,
VolumeControl.volume-inactive VolumeMeter {
    background: #0b1118;
}

VolumeControl.volume-hidden .mixer-name,
VolumeControl.volume-inactive .mixer-name {
    color: #94a8ba;
}

VolumeControl .mixer-category {
    font-weight: bold;
    background: #101923;
    color: #c1edf7;
}

VolumeControl.volume-pinned .mixer-category {
    background: #101e2a;
    color: #f2f6fa;
}

VolumeControl.volume-hidden .mixer-category {
    background: #2E1A60;
    color: #997FDC;
}

VolumeControl.volume-unassigned .mixer-category {
    background: #493709;
    color: #EABC48;
}

VolumeControl.volume-inactive .mixer-category {
    background: #0b1118;
    color: #94a8ba;
}

VolumeControl.volume-preview .mixer-category {
    background: #0F4313;
    color: #59D966;
}

#stackedMixerArea VolumeControl.volume-hidden QSlider::groove,
#stackedMixerArea VolumeControl.volume-inactive QSlider::groove {
    background: #0b1118;
}



