    qproperty-videoIcon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/settings/video.svg);
    qproperty-hotkeysIcon: url(/Applications/OBS.app/Contents/Resources/themes/Dark/settings/hotkeys.svg);
