#previewScalePercent,
#previewScalingMode {
    background: transparent;
    color: #94a8ba;
    font-size: 7.8pt;
    height: 14px;
    max-height: 14px;
    padding: 0px;
    margin: 0;
    border: none;
    border-radius: 0;
}

#previewXContainer {
    border: 1px solid #141e29;
}

#previewScalePercent {
    padding: 0px 9px;
